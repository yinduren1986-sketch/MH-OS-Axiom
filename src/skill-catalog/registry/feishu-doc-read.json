{
  "skill_id": "feishu-doc",
  "action_verb": "read",
  "target_object": "feishu-doc",
  "description": "读取飞书文档内容",
  "constraints": {
    "risk_level": "low",
    "requires_confirmation": false,
    "idempotent": true
  },
  "input_schema": {
    "doc_token": {
      "type": "string",
      "required": true,
      "source": "context",
      "description": "飞书文档 token（从 URL 中提取）"
    }
  },
  "output_schema": {
    "type": "object",
    "storage": "memory",
    "ref_as": "feishu_doc_content"
  },
  "exec_log": {
    "enabled": true,
    "fields": ["doc_token", "action", "timestamp"]
  }
}